{
  "name": "hydro-inkeep-preview-runtime",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "test": "node --test",
    "setup:local": "node scripts/setup-local.mjs",
    "prepare:migrations": "node scripts/prepare-migrations.mjs",
    "init:project": "node --env-file=.env project.mjs",
    "init:app": "node --env-file=.env scripts/create-local-app.mjs --create-anonymous-app"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@inkeep/agents-api": "0.80.6",
    "@inkeep/agents-core": "0.80.6",
    "@inkeep/agents-sdk": "0.80.6",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.4",
    "pg": "^8.16.3",
    "zod": "4.3.6"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    },
    "patchedDependencies": {
      "@ai-sdk/anthropic@3.0.7": "patches/@ai-sdk__anthropic@3.0.7.patch"
    }
  }
}
