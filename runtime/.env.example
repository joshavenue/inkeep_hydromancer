# Server-side only. Generate .env with: node scripts/setup-local.mjs
# Placeholders below are NOT usable credentials. Never serve or commit .env.
ENVIRONMENT=development
# Inkeep 0.80.6's custom provider logs an API-key prefix at info level.
LOG_LEVEL=warn
TENANT_ID=hydromancer-preview
INKEEP_AGENTS_API_URL=http://127.0.0.1:18502
INKEEP_AGENTS_MANAGE_DATABASE_URL=postgresql://hydromancer_demo:{{MANAGE_DB_PASSWORD}}@127.0.0.1:18532/inkeep_hydromancer_manage?sslmode=disable
INKEEP_AGENTS_RUN_DATABASE_URL=postgresql://hydromancer_demo:{{RUN_DB_PASSWORD}}@127.0.0.1:18533/inkeep_hydromancer_run?sslmode=disable
INKEEP_AGENTS_MANAGE_UI_USERNAME=admin@example.invalid
INKEEP_AGENTS_MANAGE_UI_PASSWORD={{ADMIN_PASSWORD}}
BETTER_AUTH_SECRET={{BETTER_AUTH_SECRET}}
INKEEP_AGENTS_JWT_SIGNING_SECRET={{JWT_SECRET}}
INKEEP_AGENTS_MANAGE_API_BYPASS_SECRET={{MANAGE_BYPASS_SECRET}}
SPICEDB_ENDPOINT=127.0.0.1:18551
SPICEDB_PRESHARED_KEY={{SPICEDB_KEY}}
SPICEDB_TLS_ENABLED=false

# Model. Default: GPT-6 Luna through the team's OpenRouter account, the cheapest
# model that handles tool calls well ($0.10 / 1M input, $0.50 / 1M output,
# reasoning off, 700-token answers). Alternatives: anthropic/claude-haiku-5-5 with
# ANTHROPIC_API_KEY (same $0.10 / $0.50 rate), openrouter/<vendor>/<model>,
# openai/<model> with OPENAI_API_KEY, google/<model> with GOOGLE_GENERATIVE_AI_API_KEY,
# or custom/<id> with an OpenAI-compatible endpoint.
MODEL=openrouter/openai/gpt-6-luna
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: low|medium|high|xhigh|max re-enables adaptive thinking at that effort (slower, more output tokens).
ANTHROPIC_EFFORT=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# custom/ provider only: Chat Completions endpoint (usually ends in /v1) and its key.
MODEL_BASE_URL=
CUSTOM_LLM_API_KEY=
# Only opt in for a trusted, intentionally keyless loopback proxy; never remote.
MODEL_ALLOW_UNAUTHENTICATED_LOOPBACK=0